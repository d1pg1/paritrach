generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  USER
}

enum RoundStatus {
  SETUP
  BETTING
  CLOSED
  RESULTS
}

enum MatchStatus {
  SCHEDULED
  IN_PROGRESS
  FINAL
}

model User {
  id                 String             @id @default(cuid())
  username           String             @unique
  nickname           String?
  logoUrl            String?
  passwordHash       String
  role               Role               @default(USER)
  createdAt          DateTime           @default(now())
  bets               Bet[]
  seasonContestants  SeasonContestant[]
}

model Season {
  id           String             @id @default(cuid())
  name         String
  archivedAt   DateTime           @default(now())
  rounds       Round[]
  contestants  SeasonContestant[]
}

model SeasonContestant {
  id       String  @id @default(cuid())
  seasonId String?
  userId   String
  season   Season? @relation(fields: [seasonId], references: [id])
  user     User    @relation(fields: [userId], references: [id])
}

model Round {
  id        String      @id @default(cuid())
  name      String
  status    RoundStatus @default(SETUP)
  createdAt DateTime    @default(now())
  seasonId  String?
  season    Season?     @relation(fields: [seasonId], references: [id])
  matches   Match[]
  bets      Bet[]
}

model Team {
  id        String   @id @default(cuid())
  name      String   @unique
  logoUrl   String?
  createdAt DateTime @default(now())
}

model Match {
  id            String        @id @default(cuid())
  roundId       String
  round         Round         @relation(fields: [roundId], references: [id])
  externalId    String?
  competition   String?
  homeTeam      String
  awayTeam      String
  startTime     DateTime
  homeScore     Int?
  awayScore     Int?
  htHomeScore   Int?
  htAwayScore   Int?
  liveHomeScore Int?
  liveAwayScore Int?
  apiFootballId Int?
  status        MatchStatus   @default(SCHEDULED)
  isEligible    Boolean       @default(false)
  oddsSnapshot  OddsSnapshot?
  bets          Bet[]
  events        MatchEvent[]
}

model MatchEvent {
  id         String   @id @default(cuid())
  matchId    String
  match      Match    @relation(fields: [matchId], references: [id])
  minute     Int
  team       String
  scorerName String?
  eventType  String
  createdAt  DateTime @default(now())

  @@unique([matchId, minute, team])
}

model OddsSnapshot {
  id        String   @id @default(cuid())
  matchId   String   @unique
  match     Match    @relation(fields: [matchId], references: [id])
  fetchedAt DateTime @default(now())
  oddsData  Json
}

model Bet {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  matchId     String
  match       Match    @relation(fields: [matchId], references: [id])
  roundId     String
  round       Round    @relation(fields: [roundId], references: [id])
  marketType  String
  selection   String
  line        Float?
  coefficient Float
  isWinner    Boolean?
  createdAt   DateTime @default(now())

  @@unique([userId, matchId])
}

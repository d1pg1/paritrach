generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String            @id @default(cuid())
  username          String            @unique
  passwordHash      String
  role              Role              @default(USER)
  createdAt         DateTime          @default(now())
  nickname          String?
  logoUrl           String?
  telegramUsername  String?
  bets              Bet[]
  seasonContestants SeasonContestant?
}

model Season {
  id          String             @id @default(cuid())
  name        String
  archivedAt  DateTime           @default(now())
  rounds      Round[]
  contestants SeasonContestant[]
}

model Settings {
  id                String  @id @default("singleton")
  currentSeasonName String?
}

model SeasonContestant {
  id       String  @id @default(cuid())
  seasonId String?
  userId   String  @unique(map: "sc_current_user_uniq", where: raw("(\"seasonId\" IS NULL)"))
  season   Season? @relation(fields: [seasonId], references: [id])
  user     User    @relation(fields: [userId], references: [id])

  @@unique([seasonId, userId], map: "sc_season_user_uniq", where: raw("(\"seasonId\" IS NOT NULL)"))
}

model Round {
  id                        String      @id @default(cuid())
  name                      String
  status                    RoundStatus @default(SETUP)
  createdAt                 DateTime    @default(now())
  seasonId                  String?
  telegramReminderMessageId String?
  bets                      Bet[]
  matches                   Match[]
  season                    Season?     @relation(fields: [seasonId], references: [id])
}

model Team {
  id        String   @id @default(cuid())
  name      String   @unique
  logoUrl   String?
  createdAt DateTime @default(now())
}

model Match {
  id            String        @id @default(cuid())
  roundId       String
  externalId    String?
  homeTeam      String
  awayTeam      String
  startTime     DateTime
  homeScore     Int?
  awayScore     Int?
  htHomeScore   Int?
  htAwayScore   Int?
  rtHomeScore   Int?
  rtAwayScore   Int?
  status        MatchStatus   @default(SCHEDULED)
  isEligible    Boolean       @default(false)
  competition   String?
  liveHomeScore Int?
  liveAwayScore Int?
  apiFootballId Int?
  bets          Bet[]
  round         Round         @relation(fields: [roundId], references: [id])
  events        MatchEvent[]
  oddsSnapshot  OddsSnapshot?
}

model MatchEvent {
  id         String   @id @default(cuid())
  matchId    String
  minute     Int
  team       String
  scorerName String?
  eventType  String
  createdAt  DateTime @default(now())
  match      Match    @relation(fields: [matchId], references: [id])

  @@unique([matchId, minute, team])
}

model OddsSnapshot {
  id        String   @id @default(cuid())
  matchId   String   @unique
  fetchedAt DateTime @default(now())
  oddsData  Json
  match     Match    @relation(fields: [matchId], references: [id])
}

model Bet {
  id          String   @id @default(cuid())
  userId      String
  matchId     String
  roundId     String
  marketType  String
  selection   String
  line        Float?
  coefficient Float
  isWinner    Boolean?
  createdAt   DateTime @default(now())
  match       Match    @relation(fields: [matchId], references: [id])
  round       Round    @relation(fields: [roundId], references: [id])
  user        User     @relation(fields: [userId], references: [id])

  @@unique([userId, matchId])
}

enum Role {
  ADMIN
  USER
}

enum RoundStatus {
  SETUP
  BETTING
  CLOSED
  RESULTS
}

enum MatchStatus {
  SCHEDULED
  IN_PROGRESS
  FINAL
}
